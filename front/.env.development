ENV=development

# Browser API prefix and development proxy target.
DEV_SERVER_PORT=9528
VUE_APP_BACKEND_URL=http://127.0.0.1:3000
VUE_APP_API_BASE_URL=/api/v1
# Empty: derive ws/wss and /stream from API_BASE_URL.
VUE_APP_WS_URL=
VUE_APP_API_TIMEOUT_MS=8000

# Layers: esri-satellite, google-satellite, dark, offline.
VUE_APP_MAP_DEFAULT_LAYER=esri-satellite
VUE_APP_MAP_ESRI_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VUE_APP_MAP_CARTO_URL=https://basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png
# Google uses Express; keep GOOGLE_MAPS_API_KEY in back/.env only.
VUE_APP_MAP_GOOGLE_TILES_PATH=maps/google/tiles/{z}/{x}/{y}
VUE_APP_MAP_GOOGLE_VIEWPORT_PATH=maps/google/viewport
# Empty: use Cesium assets bundled under the application deployment path.
VUE_APP_CESIUM_BASE_URL=
VUE_APP_MAP_OFFLINE_URL=
