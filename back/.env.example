# Server
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:9528,http://127.0.0.1:9528,http://localhost:9529,http://127.0.0.1:9529

# MariaDB: radio_station stores application configuration and imported catalogs.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=radio_station
DB_CONNECTION_LIMIT=5
# Total deadline covers pool wait, statement preparation and execution.
DB_QUERY_TIMEOUT_MS=5000

# Read-only aircraft catalog: configure actual imported table/column names.
ADSB_TABLE=
ADSB_COLUMN_MAPPING={"icao":"icao"}

# dump1090 TCP host/port is saved via the UI in signal_sources (default port 30002).

# Official Google Map Tiles API server key.
GOOGLE_MAPS_API_KEY=
# Upstream origin or a controlled reverse proxy with an optional path prefix.
GOOGLE_MAPS_API_BASE_URL=https://tile.googleapis.com

# Local receiving station, used by future satellite pass calculations.
STATION_ID=local-station
STATION_NAME=Radio Station
STATION_LATITUDE=
STATION_LONGITUDE=
STATION_ALTITUDE_METERS=
